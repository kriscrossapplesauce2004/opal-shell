            {name: "ch-03-scrolled", pad: ["down", "down", "down", "down", "down"]},
            {name: "ch-04-storage-sheet", sheet: "storage"},
            {name: "ch-05-minecraft-sheet", sheet: "minecraft"},
            {name: "ch-06-profile-sheet", sheet: "profile", profiles: {"steam:1118200": {preset: "custom", power: "balanced", fpsLimit: 45}}},
            {name: "ch-07-edit-sheet", sheet: "edit"},
            {name: "ch-08-captures", page: "captures"},
            {name: "ch-09-library", rail: "library"},
            {name: "ch-10-narrow", w: 960, h: 600},
            {name: "ch-11-light", light: true}
        ]
        Loader { id: view; anchors.fill: parent }
        Component { id: homeView; Opal.ConsoleHome {} }
        function run() {
            if (step >= cases.length) { console.log("OFFSCREEN_TESTS_COMPLETE"); Qt.quit(); return; }
            const c = cases[step];
            width = c.w || 1280; height = c.h || 800;
            Opal.Hub.prefs = Object.assign({}, Opal.Hub.prefs, {light: !!c.light, mode: "console", gamePins: ["steam:1671210", "shortcut:4110498747", "steam:1091500", "steam:281990", "steam:1118200", "steam:1148350", "steam:230290", "steam:438100"],
                                                             gameProfiles: c.profiles || {}, gameProfileNext: "balanced"});
            Opal.Hub.games = root.games;
            Opal.Hub.status = Object.assign({}, Opal.Hub.status, {battery: 73, charging: false, wifi: true});
            Opal.GameState.widgets = root.widgets;
            Opal.GameState.perf = {event: "gamePerf", controllers: [{name: "Controller", percent: 64, charging: false}], profiles: {available: true, profiles: ["power-saver", "balanced", "performance"]}};
            Opal.ControllerNav.usingController = true;
            view.sourceComponent = null; view.sourceComponent = homeView;
            settle.restart();
        }
        Timer { id: settle; interval: 700; onTriggered: {
            const c = fixture.cases[fixture.step], item = view.item;
            if (c.sheet) item.sheet = c.sheet;
            if (c.page) item.openPage(c.page);
            if (c.rail) item.railPick(c.rail);
            (c.pad || []).forEach((k, i) => Qt.callLater(() => {}));
            fixture.padIndex = 0; pad.restart();
        } }
        property int padIndex: 0
        Timer { id: pad; interval: 180; repeat: true; onTriggered: {
            const c = fixture.cases[fixture.step], keys = c.pad || [];
            const id = root.details;
            const f = view.item && view.item.featured;
            if (f && id[f.id]) Opal.GameState.detail = Object.assign({}, id[f.id]);
            if (fixture.padIndex < keys.length) { Opal.ControllerNav.input(keys[fixture.padIndex]); fixture.padIndex++; return; }
            stop(); grab.restart();
        } }
        Timer { id: grab; interval: 2200; onTriggered: {
            const f = view.item && view.item.featured;
            if (f && root.details[f.id]) Opal.GameState.detail = Object.assign({}, root.details[f.id]);
            fixture.contentItem.grabToImage(r => { r.saveToFile(Quickshell.env("OPAL_TEST_OUTPUT") + "/" + fixture.cases[fixture.step].name + ".png"); fixture.step++; fixture.run(); });
        } }
        Component.onCompleted: Qt.callLater(run)
        // The sandbox backend publishes its own empty library and status; keep the fixture in place.
        Timer { interval: 60; repeat: true; running: true; onTriggered: {
            if (Opal.Hub.games !== root.games) Opal.Hub.games = root.games;
            if (Opal.GameState.widgets !== root.widgets) Opal.GameState.widgets = root.widgets;
            if (Opal.Hub.status.battery !== 73) Opal.Hub.status = Object.assign({}, Opal.Hub.status, {battery: 73, charging: false, wifi: true});
            if (!(Opal.GameState.perf.controllers || []).length) Opal.GameState.perf = {event: "gamePerf", controllers: [{name: "Controller", percent: 64, charging: false}], profiles: {available: true, profiles: ["power-saver", "balanced", "performance"]}};
        } }
    }
}
