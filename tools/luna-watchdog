#!/usr/bin/env python3
"""Supervise the Opal shell: restart after a crash, start safe mode after three crashes in 60 s."""
import argparse
import collections
import datetime
import json
import os
import pathlib
import signal
import subprocess
import sys
import tempfile
import threading
import time

WINDOW = 60.0
CRASH_LIMIT = 3
BACKOFF_BASE = 1.0
BACKOFF_MAX = 30.0
LOG_LINES = 200
POLL = 0.05
STOP_GRACE = 5.0
SOURCE_DIR = pathlib.Path(__file__).resolve().parents[1]
# Exit codes that end supervision: a normal exit, or a stop by SIGTERM or SIGINT.
CLEAN_EXITS = (0, -signal.SIGTERM, -signal.SIGINT)


def xdg(name, fallback):
    return pathlib.Path(os.environ.get(name) or pathlib.Path.home() / fallback)


def config_dir():
    if os.environ.get('OPAL_CONFIG_DIR'):
        return pathlib.Path(os.environ['OPAL_CONFIG_DIR'])
    return xdg('XDG_CONFIG_HOME', '.config') / 'quickshell' / 'opal'


def state_dir():
    return xdg('XDG_STATE_HOME', '.local/state') / 'opal'


def runtime_dir():
    return pathlib.Path(os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}') / 'opal'


def write_atomic(path, text):
    path = pathlib.Path(path)
    fd, temp = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name + '.')
    with os.fdopen(fd, 'w', encoding='utf-8') as handle:
        handle.write(text)
    os.replace(temp, path)


def tool_version(program):
    try:
        done = subprocess.run([program, '--version'], capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return 'unknown'
    lines = (done.stdout or done.stderr).strip().splitlines()
    return lines[0] if lines else 'unknown'


def git_describe(source):
    if source is None:
        return 'unknown'
    try:
        done = subprocess.run(['git', '-C', str(source), 'describe', '--always', '--dirty', '--tags'],
                              capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return 'unknown'
    text = done.stdout.strip()
    return text if done.returncode == 0 and text else 'unknown'


class Watchdog:
    def __init__(self, command, safe_command, state_dir, retry_file, source_dir=None,
                 clock=time.monotonic, sleep=time.sleep, forward=None, on_event=None):
        self.command = list(command)
        self.safe_command = list(safe_command)
        self.state_dir = pathlib.Path(state_dir)
        self.retry_file = pathlib.Path(retry_file)
        self.source_dir = source_dir
        self.clock = clock
        self.sleep = sleep
        self.forward = forward if forward is not None else sys.stderr
        self.on_event = on_event
        self.mode = 'normal'
        self.current = self.command
        self.child = None
        self.reader = None
        self.lines = collections.deque(maxlen=LOG_LINES)
        self.crashes = []
        self.safe_crashes = 0
        self.total_crashes = 0
        self.starts = 0
        self.last_report = None
        self.stop_requested = False

    @property
    def crash_dir(self):
        return self.state_dir / 'crashes'

    @property
    def state_file(self):
        return self.state_dir / 'watchdog.json'

    def event(self, name, *data):
        if self.on_event is not None:
            self.on_event(name, *data)
        self.forward.write('luna-watchdog: ' + ' '.join([name, *map(str, data)]) + '\n')
        self.forward.flush()

    def stop(self):
        self.stop_requested = True

    def run(self):
        self.state_dir.mkdir(parents=True, exist_ok=True)
        self.spawn(self.command, 'normal')
        while not self.stop_requested:
            if self.mode == 'safe' and self.retry_requested():
                self.leave_safe_mode()
                continue
            code = self.child.poll()
            if code is None:
                time.sleep(POLL)
                continue
            self.finish_reader()
            if self.stop_requested or code in CLEAN_EXITS:
                break
            self.handle_crash(code)
        self.stop_child()
        self.event('stop')
        self.write_state(running=False)

    def count_crash(self, now):
        # Keep only the crashes that fall inside the window.
        self.crashes = [t for t in self.crashes if now - t < WINDOW] + [now]
        return len(self.crashes)

    def handle_crash(self, code):
        self.total_crashes += 1
        count = self.count_crash(self.clock())
        self.last_report = self.write_report(code)
        self.event('crash', code, self.last_report)
        if self.mode == 'normal' and count >= CRASH_LIMIT:
            self.event('safe')
            self.spawn(self.safe_command, 'safe')
            return
        if self.mode == 'safe':
            self.safe_crashes += 1
            delay = min(BACKOFF_MAX, BACKOFF_BASE * 2 ** (self.safe_crashes - 1))
            command, mode = self.safe_command, 'safe'
        else:
            delay = min(BACKOFF_MAX, BACKOFF_BASE * 2 ** (count - 1))
            command, mode = self.command, 'normal'
        self.event('backoff', delay)
        self.pause(delay)
        if not self.stop_requested:
            self.spawn(command, mode)

    def pause(self, seconds):
        # Check the stop flag often, so SIGTERM ends a long pause quickly.
        end = self.clock() + seconds
        while not self.stop_requested and self.clock() < end:
            self.sleep(min(POLL, end - self.clock()))

    def retry_requested(self):
        try:
            self.retry_file.unlink()
        except FileNotFoundError:
            return False
        return True

    def leave_safe_mode(self):
        self.event('retry')
        self.stop_child()
        self.crashes = []
        self.safe_crashes = 0
        self.spawn(self.command, 'normal')

    def spawn(self, command, mode):
        self.mode = mode
        self.current = list(command)
        self.starts += 1
        env = dict(os.environ, OPAL_WATCHDOG_RETRY=str(self.retry_file))
        env.pop('OPAL_CRASH_REPORT', None)
        if mode == 'safe' and self.last_report is not None:
            env['OPAL_CRASH_REPORT'] = str(self.last_report)
        # Each child gets its own stderr buffer, so a report holds only its own lines.
        self.lines = collections.deque(maxlen=LOG_LINES)
        self.child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stderr=subprocess.PIPE, env=env)
        self.reader = threading.Thread(target=self.read_stderr, args=(self.child.stderr, self.lines), daemon=True)
        self.reader.start()
        self.event('spawn', mode, self.child.pid)
        self.write_state(running=True)

    def read_stderr(self, pipe, lines):
        for raw in iter(pipe.readline, b''):
            line = raw.decode('utf-8', 'replace')
            lines.append(line)
            try:
                self.forward.write(line)
                self.forward.flush()
            except (OSError, ValueError):
                pass
        pipe.close()

    def finish_reader(self):
        if self.reader is not None:
            # A grandchild can hold the pipe open, so do not wait forever.
            self.reader.join(2)

    def stop_child(self):
        child = self.child
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(STOP_GRACE)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        self.finish_reader()

    def write_report(self, code):
        now = datetime.datetime.now()
        stamp = now.strftime('%Y%m%d-%H%M%S')
        folder = self.crash_dir / stamp
        index = 1
        while folder.exists():
            folder = self.crash_dir / f'{stamp}-{index}'
            index += 1
        folder.mkdir(parents=True)
        write_atomic(folder / 'log.txt', ''.join(list(self.lines)))
        info = {
            'created': now.isoformat(timespec='seconds'),
            'mode': self.mode,
            'exit_code': code if code >= 0 else None,
            'signal': signal.Signals(-code).name if code < 0 else None,
            'command': self.current,
            'command_version': tool_version(self.current[0]),
            'source': git_describe(self.source_dir),
        }
        write_atomic(folder / 'report.json', json.dumps(info, indent=2) + '\n')
        return folder

    def write_state(self, running):
        state = {
            'mode': self.mode,
            'running': running,
            'pid': self.child.pid if running and self.child is not None else None,
            'crashes_in_window': len(self.crashes),
            'total_crashes': self.total_crashes,
            'starts': self.starts,
            'last_report': str(self.last_report) if self.last_report is not None else None,
            'updated': time.time(),
        }
        write_atomic(self.state_file, json.dumps(state, indent=2) + '\n')


def parse_args(argv):
    # Options come before "--". The shell command comes after it.
    if '--' in argv:
        cut = argv.index('--')
        options, command = argv[:cut], argv[cut + 1:]
    else:
        options, command = argv, []
    parser = argparse.ArgumentParser(usage='luna-watchdog [options] -- [COMMAND...]',
                                     description='Supervise the Opal shell.')
    parser.add_argument('--state-dir', type=pathlib.Path, default=state_dir())
    parser.add_argument('--retry-file', type=pathlib.Path, default=runtime_dir() / 'watchdog-retry')
    parser.add_argument('--safe-entry', type=pathlib.Path, default=config_dir() / 'safe-mode.qml')
    parser.add_argument('--source', type=pathlib.Path, default=SOURCE_DIR)
    args = parser.parse_args(options)
    if not command:
        command = ['quickshell', '-n', '-p', str(config_dir())]
    return args, command


def main(argv=None):
    args, command = parse_args(sys.argv[1:] if argv is None else argv)
    safe = ['quickshell', '-n', '-p', str(args.safe_entry)]
    watchdog = Watchdog(command, safe, args.state_dir, args.retry_file, source_dir=args.source)

    def request_stop(signum, frame):
        watchdog.stop()

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    try:
        watchdog.run()
    except OSError as error:
        print(f'luna-watchdog: {error}', file=sys.stderr)
        return 127
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
